<odoo>
  <data>
    <!-- model buku -->
    <record model="ir.ui.view" id="view_form_buku">
      <field name="name">perpustakaan.buku.form</field>
      <field name="model">perpustakaan.buku</field>
      <field name="arch" type="xml">
        <form>
		  <sheet>
		    <group>
		      <field name="judul" string="Judul Buku"/>
              <field name="ISBN" string="ISBN"/>
              <field name="stok" string="Stok"/>
		    </group>
		   </sheet>
        </form>
      </field>
    </record>

	<!-- ni dibawah list buat text box -->

<record model="ir.ui.view" id="view_list_buku">
  <field name="name">perpustakaan.buku.list</field>
  <field name="model">perpustakaan.buku</field>
  <field name="arch" type="xml">
    <list>
      <field name="judul" string="Judul Buku"/>
      <field name="ISBN" string="ISBN"/>
      <field name="stok" string="Stok"/>
    </list>
  </field>
</record>

    <record id="action_buku" model="ir.actions.act_window">
        <field name="name">Buku</field>
        <field name="res_model">perpustakaan.buku</field>
        <field name="view_mode">list,form</field>
    </record>

	<menuitem id="menu_perpustakaan_root" name="Perpustakaan"/>
    <menuitem id="menu_buku" name="Buku" parent="menu_perpustakaan_root" action="action_buku"/>

	<!-- model oeminjaman -->
<record model="ir.ui.view" id="view_form_peminjaman">
  <field name="name">perpustakaan.peminjaman.form</field>
  <field name="model">perpustakaan.peminjaman</field>
  <field name="arch" type="xml">
    <form>
	  <sheet>
	    <group>
          <field name="buku_id" string="ID buku"/>
          <field name="peminjam" string="Nama Peminjam"/>
          <field name="tanggal_pinjam" string="Tanggal dipinjam"/>
		  <field name="status" string="status"/>
	    </group>
	  </sheet>
    </form>
  </field>
</record>

<!-- ni dibawah list buat text box -->

<record model="ir.ui.view" id="view_list_peminjaman">
  <field name="name">perpustakaan.peminjaman.list</field>
  <field name="model">perpustakaan.peminjaman</field>
  <field name="arch" type="xml">
    <list>
      <field name="buku_id" string="Buku"/>
      <field name="peminjam" string="Nama Peminjam"/>
      <field name="tanggal_pinjam" string="Tanggal Pinjam"/>
      <field name="status" string="Status"/>
    </list>
  </field>
</record>

<record id="action_peminjaman" model="ir.actions.act_window">
  <field name="name">Peminjaman</field>
  <field name="res_model">perpustakaan.peminjaman</field>
  <field name="view_mode">list,form</field>
</record>

<menuitem id="menu_peminjaman" name="Peminjaman" parent="menu_perpustakaan_root" action="action_peminjaman"/>


  </data>
</odoo>
